# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PEXELS_API_KEY: Required for fetching gaming images from Pexels.
# Get your key at https://www.pexels.com/api/new/
PEXELS_API_KEY=""

# Optional: public API gateway base URL.
# Leave unset to use the app's built-in gateway defaults.
# VITE_API_URL="https://api-gateway-216098834386.us-central1.run.app"

# Notification-service Socket.IO endpoint used for realtime events.
# Local development: http://localhost:5006/events
VITE_NOTIFICATION_SOCKET_URL="http://localhost:5006/events"
